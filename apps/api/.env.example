# Copy to apps/api/.env (git-ignored). Never commit real keys.

# Optional. Without these values, the event planner returns a labelled synthetic plan.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenClaw agent gateway. Enable its /v1/chat/completions endpoint and keep the token server-side.
# When configured, Ask ThirdPlace uses OpenClaw first and OpenRouter as a fallback.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Optional durable prototype storage path. Defaults to apps/api/.data/runtime.json.
# Use :memory: only for disposable development runs.
THIRDPLACE_DATA_FILE=

# Stripe SANDBOX only (business promotions). Dashboard (Test mode) -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: from `stripe listen --forward-to localhost:3001/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
# Optional overrides
WEB_BASE_URL=http://localhost:5173
BUSINESS_PORTAL_PATH=/src/features/business/portal.html
