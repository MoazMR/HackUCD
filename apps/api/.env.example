# Copy to apps/api/.env (git-ignored) and fill in Stripe SANDBOX values. Never commit real keys.
# Stripe Dashboard (Test mode) -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: from `stripe listen --forward-to localhost:3001/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
# Optional overrides
WEB_BASE_URL=http://localhost:5173
BUSINESS_PORTAL_PATH=/src/features/business/portal.html
